{
  "name": "skincentral",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*", "/admin/*"]
  },
  "vars": {
    "SITE_URL": "https://skincentral.estatic.cc",
    "DISCORD_CLIENT_ID": "1556006055677268008",
    "GUILD_ID": "1353549460680085525",
    "MOD_ROLE_ID": "1556006566497624074"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "skincentral-db",
      "database_id": "0ea055f6-9e3d-4213-bb43-6a1127404614"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "skincentral-files"
    }
  ]
}
